# ============================================================================
# VTOWER DASHBOARD — variables de entorno
# ----------------------------------------------------------------------------
# Copia este archivo a  .env.local  y rellena los valores que necesites.
# TODAS son opcionales para arrancar: si falta una integración, el panel
# simplemente muestra esa sección vacía en vez de tronar. Rellena solo las
# que vayas a usar.
#
#   cp .env.example .env.local
#
# En producción (Vercel u otro) carga estas mismas variables en el panel
# de "Environment Variables" del proyecto.
# ============================================================================

# ----------------------------------------------------------------------------
# Protección del panel (middleware.ts)
# ----------------------------------------------------------------------------
# Contraseña compartida para entrar al panel. Si se deja vacía, el panel
# queda abierto a cualquiera con la URL.
PANEL_PASSWORD=""

# ----------------------------------------------------------------------------
# GoHighLevel (GHL) — fuente PRIMARIA de leads  (lib/ghl.ts)
# ----------------------------------------------------------------------------
# Private Integration Token (empieza con "pit-").
GHL_PRIVATE_TOKEN=""
GHL_LOCATION_ID=""
# Opcional: nombre EXACTO del pipeline usado como embudo de leads de Meta.
GHL_MARKETING_PIPELINE_NAME="Marketing Pipeline"
# Opcional: mapa fijo userId -> nombre, por si el endpoint de usuarios falla.
# GHL_USERS_FALLBACK='{"userId1":"Nombre Apellido"}'

# ----------------------------------------------------------------------------
# Google Sheets — fuente de leads legada / enriquecimiento  (lib/googleSheets.ts)
# ----------------------------------------------------------------------------
# Cuenta de servicio con acceso de "Lector" al Sheet (compartido con su correo).
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# La llave privada va en una sola línea con "\n" literales.
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=""

# ----------------------------------------------------------------------------
# HubSpot — enriquecimiento de estado de leads  (lib/hubspot.ts)
# ----------------------------------------------------------------------------
# Token de una Private App. Scopes: crm.objects.contacts.read (+ owners.read).
HUBSPOT_ACCESS_TOKEN=""
# Opcionales:
HUBSPOT_LEAD_STAGE_PROPERTY="etapa_del_lead"
# HUBSPOT_EXTRA_PROPERTIES="empresa,jobtitle,hs_analytics_source"
# HUBSPOT_CREATED_SINCE="2026-06-01"
HUBSPOT_CONTACT_LIMIT="300"

# ----------------------------------------------------------------------------
# Meta / Facebook Marketing API  (lib/metaAds.ts, app/api/meta-audit, meta-campaign)
# ----------------------------------------------------------------------------
# Token de la Marketing API (idealmente System User token, no caduca).
META_ACCESS_TOKEN=""
META_API_VERSION="v22.0"
# Opcional: incluye diagnóstico del pixel.
# META_PIXEL_ID=""

# Cuentas publicitarias visibles en la UI (prefijo NEXT_PUBLIC_ obligatorio,
# se leen en el cliente). JSON en una sola línea.
NEXT_PUBLIC_META_AD_ACCOUNTS='[{"name":"Cuenta 1","accountId":"act_XXXXXXXXXXXX"}]'
# ID de la página de Facebook usada por defecto al crear campañas.
NEXT_PUBLIC_META_PAGE_ID=""

# ----------------------------------------------------------------------------
# Anthropic (Claude) — auditoría de Meta Ads y generación de campañas
#   (lib/metaAudit.ts, lib/metaCampaignGenerator.ts, lib/metaImagePicker.ts)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ----------------------------------------------------------------------------
# Google Drive — imágenes para creativos  (lib/driveImages.ts)
# ----------------------------------------------------------------------------
# Cuenta de servicio DISTINTA a la de Sheets (solo lectura de Drive).
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
# Mapa cuenta publicitaria -> carpeta(s) de Drive. JSON en una sola línea.
GOOGLE_DRIVE_ACCOUNT_FOLDERS='[{"accountId":"act_XXXXXXXXXXXX","folderId":"DRIVE_FOLDER_ID"}]'

# ----------------------------------------------------------------------------
# Cron semanal de campañas  (app/api/cron/weekly-campaign/route.ts)
# ----------------------------------------------------------------------------
# En Vercel, CRON_SECRET lo genera la plataforma sola. En local defínelo tú
# si quieres probar la ruta manualmente.
CRON_SECRET=""
# Cuentas para las que se genera una campaña PAUSADA cada semana. JSON.
# META_WEEKLY_CAMPAIGN_ACCOUNTS='[{"accountId":"act_XXXXXXXXXXXX","businessDescription":"...","targetDescription":"...","dailyBudgetMXN":300,"pageId":"..."}]'
